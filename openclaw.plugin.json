{
  "id": "resilience",
  "name": "Resilience",
  "description": "LLM API and agent session error tracking, classification, retry, and recovery dashboard",
  "version": "0.5.0",
  "author": "leiJack-lo",
  "license": "MIT",
  "contracts": {
    "tools": [
      "resilience_stats",
      "resilience_strategies",
      "resilience_report",
      "resilience_dashboard",
      "resilience_recovery",
      "resilience_sessions"
    ]
  },
  "activation": {
    "onStartup": true,
    "onCapabilities": ["hook", "tool"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "logDir": {
        "type": "string",
        "description": "Custom log directory path"
      },
      "statsRetentionDays": {
        "type": "number",
        "description": "Days to keep stats data",
        "default": 90
      },
      "defaultStrategy": {
        "type": "string",
        "enum": ["fixed", "exponential", "custom"],
        "description": "Default retry strategy type",
        "default": "exponential"
      },
      "dashboardEnabled": {
        "type": "boolean",
        "description": "Start web dashboard when gateway starts",
        "default": true
      },
      "dashboardPort": {
        "type": "number",
        "description": "Dashboard HTTP port (localhost only)",
        "default": 18765
      },
      "instanceId": {
        "type": "string",
        "description": "Override instance id for isolated stats (default: gateway-instance-id)"
      },
      "instanceLabel": {
        "type": "string",
        "description": "Display name in multi-instance dashboard"
      },
      "workspacePath": {
        "type": "string",
        "description": "Workspace path used for instance label"
      },
      "sessionRecoveryEnabled": {
        "type": "boolean",
        "description": "Queue next-turn recovery instructions when agent sessions fail",
        "default": true
      },
      "sessionRecoveryLanguage": {
        "type": "string",
        "enum": ["zh", "en"],
        "description": "Default language for recovery instructions",
        "default": "zh"
      },
      "sessionRecoveryPrompt": {
        "type": "string",
        "description": "Custom recovery prompt overriding localized defaults"
      },
      "sessionRecoveryPromptZh": {
        "type": "string",
        "description": "Custom Chinese recovery prompt"
      },
      "sessionRecoveryPromptEn": {
        "type": "string",
        "description": "Custom English recovery prompt"
      },
      "sessionRecoveryTtlMs": {
        "type": "number",
        "description": "Queued recovery context TTL in milliseconds",
        "default": 600000
      },
      "sessionRecoveryCooldownMs": {
        "type": "number",
        "description": "Minimum interval between recovery injections per session",
        "default": 300000
      },
      "sessionRecoveryMaxPerSession": {
        "type": "number",
        "description": "Maximum automatic recovery injections per session",
        "default": 3
      }
    },
    "additionalProperties": false
  }
}
