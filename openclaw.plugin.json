{
  "id": "resilience",
  "name": "Resilience",
  "description": "LLM API error tracking, classification, retry, and task recovery",
  "version": "0.3.0",
  "author": "leiJack-lo",
  "license": "Apache-2.0",
  "contracts": {
    "tools": [
      "resilience_stats",
      "resilience_strategies",
      "resilience_report",
      "resilience_dashboard"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "logDir": {
        "type": "string",
        "description": "Custom log directory path"
      },
      "statsRetentionDays": {
        "type": "number",
        "description": "Days to keep stats data",
        "default": 90
      },
      "defaultStrategy": {
        "type": "string",
        "enum": ["fixed", "exponential", "custom"],
        "description": "Default retry strategy type",
        "default": "exponential"
      },
      "dashboardEnabled": {
        "type": "boolean",
        "description": "Start web dashboard when gateway starts",
        "default": true
      },
      "dashboardPort": {
        "type": "number",
        "description": "Dashboard HTTP port (localhost only)",
        "default": 18765
      },
      "instanceId": {
        "type": "string",
        "description": "Override instance id for isolated stats (default: gateway-instance-id)"
      },
      "instanceLabel": {
        "type": "string",
        "description": "Display name in multi-instance dashboard"
      },
      "workspacePath": {
        "type": "string",
        "description": "Workspace path used for instance label"
      }
    },
    "additionalProperties": false
  }
}
