{
  "name": "@openclaw/resilience",
  "version": "0.2.0",
  "description": "LLM API error tracking, classification, retry, and task recovery plugin for OpenClaw",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leiJack-lo/openclaw-resilience.git"
  },
  "bugs": {
    "url": "https://github.com/leiJack-lo/openclaw-resilience/issues"
  },
  "homepage": "https://github.com/leiJack-lo/openclaw-resilience#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "verify:dashboard": "npm run build && node scripts/verify-dashboard.mjs"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.18",
      "minGatewayVersion": "2026.5.18"
    }
  },
  "keywords": [
    "openclaw",
    "plugin",
    "resilience",
    "retry",
    "error-tracking",
    "llm"
  ],
  "author": "leiJack-lo",
  "license": "Apache-2.0",
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "openclaw": "2026.5.18",
    "typescript": "^5.8.0"
  }
}
